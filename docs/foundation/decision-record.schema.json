{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atrielle.dev/aurim/schemas/decision-record.schema.json",
  "title": "Aurim Decision Record",
  "type": "object",
  "required": [
    "decision_id",
    "title",
    "status",
    "layer",
    "date",
    "context",
    "decision",
    "consequences",
    "owner",
    "related_paths"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^DEC-[0-9]{4}-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "decided", "superseded", "rejected"]
    },
    "layer": {
      "type": "string",
      "enum": ["foundation", "contract", "engine", "delivery"]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "context": {
      "type": "string",
      "minLength": 10
    },
    "decision": {
      "type": "string",
      "minLength": 10
    },
    "consequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "related_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DEC-[0-9]{4}-[0-9]{4}$"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
