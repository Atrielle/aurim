{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reusable-harness/contracts/run-contract.schema.json",
  "title": "Run Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "objective",
    "authoritative_inputs",
    "blocking_rule",
    "in_scope",
    "out_of_scope",
    "touched_paths",
    "acceptance_criteria",
    "work_units",
    "evaluator_checks"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "authoritative_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_rule": {
      "type": "string",
      "minLength": 1
    },
    "in_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "touched_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "work_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workUnit"
      }
    },
    "evaluator_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "required_evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[0-9]{3}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "workUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective",
        "touched_paths",
        "acceptance_criteria_ids",
        "required_evidence",
        "agent_budget"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WU-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "touched_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^AC-[0-9]{3}$"
          }
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agent_budget": {
          "$ref": "#/$defs/agentBudget"
        }
      }
    },
    "agentBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "depends_on"
      ],
      "properties": {
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WU-[0-9]{3}$"
          }
        }
      }
    }
  }
}
