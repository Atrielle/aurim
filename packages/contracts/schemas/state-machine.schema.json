{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reusable-harness/contracts/state-machine.schema.json",
  "title": "Run State Machine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "states",
    "transitions",
    "terminal_states"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "created",
          "planned",
          "generating",
          "evaluating",
          "retry_pending",
          "passed",
          "failed",
          "blocked",
          "aborted"
        ]
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "terminal_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "passed",
          "failed",
          "blocked",
          "aborted"
        ]
      }
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "trigger",
        "requires_evidence"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "requires_evidence": {
          "type": "boolean"
        }
      }
    }
  }
}
